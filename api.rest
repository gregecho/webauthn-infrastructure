### Health check
GET {{baseUrl}}/health
Accept: application/json

### Info
GET {{baseUrl}}/info
Accept: application/json

###############################################################################
# Registration Flow (requires JWT)
###############################################################################

### 1. Registration Start
# Returns: requestId + PublicKeyCredentialCreationOptions
POST {{baseUrl}}/webauthn/v1/registration/start
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "memberId": "{{memberId}}",
  "channel": "{{channel}}"
}

### 2. Registration Complete
# NOTE: This requires a real authenticator response from navigator.credentials.create()
# Cannot be tested with curl/REST client alone - use browser + Swagger UI
POST {{baseUrl}}/webauthn/v1/registration/complete
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "requestId": "REPLACE_WITH_REQUEST_ID_FROM_START",
  "credential": "REPLACE_WITH_BASE64_ATTESTATION_FROM_BROWSER",
  "channel": "{{channel}}",
  "memberId": "{{memberId}}",
  "deviceType": "Desktop",
  "webBrowser": "Chrome"
}

###############################################################################
# Assertion Flow (no JWT required)
###############################################################################

### 3. Assertion Start (with memberId)
# Returns: requestId + PublicKeyCredentialRequestOptions
POST {{baseUrl}}/webauthn/v1/assertion/start
Content-Type: application/json

{
  "memberId": "{{memberId}}",
  "channel": "{{channel}}"
}

### 3b. Assertion Start (without memberId - allows any credential)
POST {{baseUrl}}/webauthn/v1/assertion/start
Content-Type: application/json

{
  "channel": "{{channel}}"
}

### 4. Assertion Complete
# NOTE: This requires a real authenticator response from navigator.credentials.get()
# Cannot be tested with curl/REST client alone - use browser + Swagger UI
POST {{baseUrl}}/webauthn/v1/assertion/complete
Content-Type: application/json

{
  "requestId": "REPLACE_WITH_REQUEST_ID_FROM_START",
  "credential": "REPLACE_WITH_BASE64_ASSERTION_FROM_BROWSER"
}

###############################################################################
# Credential Management
###############################################################################

### 5. List credentials (no auth)
GET {{baseUrl}}/webauthn/v1/credentials?memberId={{memberId}}
Accept: application/json

### 6. Delete credentials v1 (JWT required)
DELETE {{baseUrl}}/webauthn/v1/credentials?memberId={{memberId}}
Authorization: Bearer {{jwt}}

### 7. Delete credentials v2 (HTTP Basic auth)
DELETE {{baseUrl}}/webauthn/v2/credentials?memberId={{memberId}}
Authorization: Basic YWRtaW46Y2hhbmdlbWU=
# Basic auth (admin:changeme) - base64(admin:changeme)

